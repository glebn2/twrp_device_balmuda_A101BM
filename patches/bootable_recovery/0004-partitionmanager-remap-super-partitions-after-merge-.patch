From 07b8ce86426f4d66996ab0b9c33be179c0871c95 Mon Sep 17 00:00:00 2001
From: glebn2 <40612835+glebn2@users.noreply.github.com>
Date: Mon, 26 Oct 2026 22:13:13 +0300
Subject: [PATCH 4/5] partitionmanager: remap super partitions after merge
 check; explain metadata decrypt failure

Check_Pending_Merges() (Format Data on Virtual A/B) unmapped the logical partitions and dropped them from the list, so zips installed afterwards could not mount system until recovery was restarted. Keep the partitions and map them again.
When metadata decryption fails, print a hint instead of only a log line.
---
 partitionmanager.cpp | 32 +++++++++++++++++++++++---------
 partitions.hpp       |  2 +-
 2 files changed, 24 insertions(+), 10 deletions(-)

diff --git a/partitionmanager.cpp b/partitionmanager.cpp
index 2766b4c..081a4cf 100755
--- a/partitionmanager.cpp
+++ b/partitionmanager.cpp
@@ -615,6 +615,11 @@ void TWPartitionManager::Decrypt_Data() {
 				}
 			} else {
 				LOGINFO("Unable to decrypt metadata encryption\n");
+				// BALMUDA: metadata decrypt hint, instead of a bare mount error later
+				gui_print_color("error", "\nUnable to decrypt /data (metadata encryption).\n");
+				gui_print("Most likely /data was created by a ROM whose boot image header has a different\n"
+					"Android version / security patch than stock (this TWRP uses 11.0.0 / 2023-09).\n"
+					"Wipe -> Format Data will clear /data, including internal storage.\n\n");
 			}
 #else
 			LOGERR("Metadata FBE decrypt support not present in this TWRP\n");
@@ -3555,7 +3560,9 @@ bool TWPartitionManager::Prepare_Super_Volume(TWPartition* twrpPart) {
     Fstab fstab;
 	std::string bare_partition_name = Get_Bare_Partition_Name(twrpPart->Get_Mount_Point());
 
-	Super_Partition_List.push_back(bare_partition_name);
+	// BALMUDA: do not duplicate the name when called again after Check_Pending_Merges
+	if (std::find(Super_Partition_List.begin(), Super_Partition_List.end(), bare_partition_name) == Super_Partition_List.end())
+		Super_Partition_List.push_back(bare_partition_name);
 	LOGINFO("Trying to prepare %s from super partition\n", bare_partition_name.c_str());
 
 	std::string blk_device_partition;
@@ -3727,7 +3734,7 @@ void TWPartitionManager::Unlock_Block_Partitions() {
 	}
 }
 
-bool TWPartitionManager::Unmap_Super_Devices() {
+bool TWPartitionManager::Unmap_Super_Devices(bool keep_partitions) {
 	bool destroyed = false;
 #ifndef TW_EXCLUDE_APEX
 	twrpApex apex;
@@ -3751,8 +3758,12 @@ bool TWPartitionManager::Unmap_Super_Devices() {
 				LOGINFO("removing cow partition: %s\n", cow_partition.c_str());
 				destroyed = DestroyLogicalPartition(cow_partition);
 			}
-			iter = Partitions.erase(iter);
-			delete part;
+			if (keep_partitions) {
+				++iter;
+			} else {
+				iter = Partitions.erase(iter);
+				delete part;
+			}
 			if (!destroyed) {
 				return false;
 			}
@@ -3771,7 +3782,7 @@ bool TWPartitionManager::Check_Pending_Merges() {
 		return false;
 	}
 
-	if (!Unmap_Super_Devices()) {
+	if (!Unmap_Super_Devices(true)) {
 		LOGERR("Unable to unmap dynamic partitions.\n");
 		return false;
 	}
@@ -3783,9 +3794,12 @@ bool TWPartitionManager::Check_Pending_Merges() {
 	};
 
 	LOGINFO("checking for merges\n");
-	if (!sm->HandleImminentDataWipe(callback)) {
+	bool merged = sm->HandleImminentDataWipe(callback);
+	if (!merged)
 		LOGERR("Unable to check merge status\n");
-		return false;
-	}
-	return true;
+	// BALMUDA: map the logical partitions again, as on TWRP start; otherwise after Format Data
+	// zip installers cannot find /dev/block/mapper/system_<slot> until recovery is restarted.
+	Setup_Super_Devices();
+	Prepare_All_Super_Volumes();
+	return merged;
 }
diff --git a/partitions.hpp b/partitions.hpp
index 843dfe5..34042ca 100755
--- a/partitions.hpp
+++ b/partitions.hpp
@@ -408,7 +408,7 @@ public:
 	void Set_Crypto_State();                                                  // Sets encryption state for devices (ro.crypto.state)
 	int Set_Crypto_Type(const char* crypto_type);                             // Sets encryption type for FDE (block) and FBE (file) devices (ro.crypto.type)
 	void Unlock_Block_Partitions();                                           // Unlock all block devices after update_engine runs
-	bool Unmap_Super_Devices();                                               // Unmap super devices in TWRP
+	bool Unmap_Super_Devices(bool keep_partitions = false);  // BALMUDA: keep_partitions: keep them in the partition list                                               // Unmap super devices in TWRP
 	bool Check_Pending_Merges();                                              // Check and run pending merges on data for VAB devices
 
 private:
-- 
2.43.0

