From abac1c42ef82e3e9a029194ff2d843a881e253c0 Mon Sep 17 00:00:00 2001
From: glebn2 <40612835+glebn2@users.noreply.github.com>
Date: Mon, 26 Oct 2026 22:13:13 +0300
Subject: [PATCH] KeystoreInfo: read a copy of locksettings.db

sqlite3_open() created an empty root-owned /data/system/locksettings.db when it was missing, which broke system_server on the next boot. Read a copy in /tmp instead and never write to /data/system.
---
 KeystoreInfo.cpp | 80 ++++++++++++++++++++++++++++++++++++++++++++----
 1 file changed, 74 insertions(+), 6 deletions(-)

diff --git a/KeystoreInfo.cpp b/KeystoreInfo.cpp
index a74a713..e797c5f 100755
--- a/KeystoreInfo.cpp
+++ b/KeystoreInfo.cpp
@@ -44,21 +44,85 @@ std::string KeystoreInfo::uint2hex(int64_t num) {
 	return s;
 }
 
+// sqlite3_open() created an empty /data/system/locksettings.db (root:root) when it was missing,
+// and system_server could not open it later. Read a copy in /tmp and leave /data/system untouched.
+static const char* kLockSettingsDb = "/data/system/locksettings.db";
+static const char* kLockSettingsCopy = "/tmp/twrp-locksettings.db";
+
+static bool copyFile(const std::string& src, const std::string& dst) {
+	int in = open(src.c_str(), O_RDONLY | O_CLOEXEC);
+	if (in < 0)
+		return false;
+	int out = open(dst.c_str(), O_WRONLY | O_CREAT | O_TRUNC | O_CLOEXEC, 0600);
+	if (out < 0) {
+		close(in);
+		return false;
+	}
+	bool ok = true;
+	char buf[65536];
+	ssize_t n;
+	while (ok && (n = read(in, buf, sizeof(buf))) != 0) {
+		if (n < 0) {
+			if (errno == EINTR)
+				continue;
+			ok = false;
+			break;
+		}
+		for (ssize_t done = 0; done < n;) {
+			ssize_t w = write(out, buf + done, n - done);
+			if (w < 0 && errno == EINTR)
+				continue;
+			if (w <= 0) {
+				ok = false;
+				break;
+			}
+			done += w;
+		}
+	}
+	close(in);
+	if (close(out) != 0)
+		ok = false;
+	return ok;
+}
+
+static void removeLockSettingsCopy() {
+	std::string copy(kLockSettingsCopy);
+	unlink(copy.c_str());
+	unlink((copy + "-wal").c_str());
+	unlink((copy + "-shm").c_str());
+	unlink((copy + "-journal").c_str());
+}
+
 std::string KeystoreInfo::getHandle(const userid_t user_id) {
 	int rc = 0;
-	sqlite3 *db;
-	sqlite3_stmt *stmt;
-	char *err_msg = 0;
+	sqlite3 *db = NULL;
+	sqlite3_stmt *stmt = NULL;
 
-	rc = sqlite3_open("/data/system/locksettings.db", &db);
-	if (rc) {
-		fprintf(stderr, "Can't open database: %s\n", sqlite3_errmsg(db));
+	if (access(kLockSettingsDb, F_OK) != 0) {
+		fprintf(stderr, "%s not found, assuming no lock screen credential\n", kLockSettingsDb);
+		return "";
+	}
+	removeLockSettingsCopy();
+	std::string wal = std::string(kLockSettingsDb) + "-wal";
+	if (!copyFile(kLockSettingsDb, kLockSettingsCopy) ||
+		(access(wal.c_str(), F_OK) == 0 && !copyFile(wal, std::string(kLockSettingsCopy) + "-wal"))) {
+		fprintf(stderr, "Can't copy %s to %s: %s\n", kLockSettingsDb, kLockSettingsCopy, strerror(errno));
+		removeLockSettingsCopy();
+		return "";
+	}
+	// READWRITE on the copy only, so SQLite replays the copied -wal.
+	rc = sqlite3_open_v2(kLockSettingsCopy, &db, SQLITE_OPEN_READWRITE, NULL);
+	if (rc != SQLITE_OK) {
+		fprintf(stderr, "Can't open database: %s\n", db ? sqlite3_errmsg(db) : "out of memory");
+		sqlite3_close(db);
+		removeLockSettingsCopy();
 		return "";
 	}
 	std::string sql = "SELECT * FROM locksettings WHERE name = 'sp-handle' AND user = " + std::to_string(user_id);
 	rc = sqlite3_prepare_v2(db, sql.c_str(), -1, &stmt, NULL);
 	if (rc != SQLITE_OK) {
 		sqlite3_close(db);
+		removeLockSettingsCopy();
 		return "";
 	}
 	int64_t value = 0;
@@ -67,10 +131,14 @@ std::string KeystoreInfo::getHandle(const userid_t user_id) {
 	}
 	if (rc != SQLITE_DONE) {
 		fprintf(stderr, "error: %s\n", sqlite3_errmsg(db));
+		sqlite3_finalize(stmt);
+		sqlite3_close(db);
+		removeLockSettingsCopy();
 		return "";
 	}
 	sqlite3_finalize(stmt);
 	sqlite3_close(db);
+	removeLockSettingsCopy();
 	return uint2hex(value);
 }
 
