# TWRP extra partitions (twrp.fstab v1: <mount_point> <fs_type> <device> <flags>).
# EFS and persist are device-specific: backup only, do not restore on another phone.
/boot           emmc  /dev/block/bootdevice/by-name/boot           flags=display="Boot";backup=1;flashimg=1;slotselect
/recovery       emmc  /dev/block/bootdevice/by-name/recovery       flags=display="Recovery";backup=1;flashimg=1;slotselect
/dtbo           emmc  /dev/block/bootdevice/by-name/dtbo           flags=display="DTBO";backup=1;flashimg=1;slotselect
/vbmeta         emmc  /dev/block/bootdevice/by-name/vbmeta         flags=display="VBMeta";backup=1;flashimg=1;slotselect
/vbmeta_system  emmc  /dev/block/bootdevice/by-name/vbmeta_system  flags=display="VBMeta System";backup=1;flashimg=1;slotselect
/firmware       vfat  /dev/block/bootdevice/by-name/modem          flags=display="Firmware";slotselect;mounttodecrypt;fsflags=ro
/persist        ext4  /dev/block/bootdevice/by-name/persist        flags=display="Persist";backup=1
/efs1           emmc  /dev/block/bootdevice/by-name/modemst1       flags=display="EFS";backup=1;subpartitionof=/efs1
/efs2           emmc  /dev/block/bootdevice/by-name/modemst2       flags=subpartitionof=/efs1
/efsg           emmc  /dev/block/bootdevice/by-name/fsg            flags=subpartitionof=/efs1
/efsc           emmc  /dev/block/bootdevice/by-name/fsc            flags=subpartitionof=/efs1
# USB OTG: UFS uses sda..sdf, the stick is sdg
/usb_otg        vfat  /dev/block/sdg1  /dev/block/sdg  flags=display="USB OTG";storage;wipeingui;removable
