on init
    write /sys/class/backlight/panel0-backlight/brightness 200
    setprop sys.usb.configfs 1

on property:ro.boot.usbcontroller=*
    setprop sys.usb.controller ${ro.boot.usbcontroller}
    write /sys/class/udc/${ro.boot.usbcontroller}/device/../mode peripheral

on fs
    wait /dev/block/platform/soc/${ro.boot.bootdevice}
    symlink /dev/block/platform/soc/${ro.boot.bootdevice} /dev/block/bootdevice

# --- TWRP additions ---
import /init.recovery.qcom_decrypt.rc

on boot
    # The kernel boots with USB host mode disabled; stock Android enables it from the framework
    write /sys/module/dwc3_msm/parameters/disable_host_mode N
    # Not started lazily (no interface lines); fastbootd needs IHealth
    start health-hal-2-1
    start hvdcp_opti

# Battery level: the qpnp-qg driver gets SOC from the QG daemon in hvdcp_opti
service hvdcp_opti /system/bin/hvdcp_opti
    user root
    group root
    disabled
    seclabel u:r:recovery:s0

# MTP uses the kernel mtp.gs0 function, as in the stock ROM
on fs && property:sys.usb.configfs=1
    mkdir /config/usb_gadget/g1/functions/mtp.gs0
    write /config/usb_gadget/g1/strings/0x409/product "BALMUDA Phone"

on property:sys.usb.config=mtp,adb && property:sys.usb.ffs.ready=1 && property:sys.usb.configfs=1
    write /config/usb_gadget/g1/UDC "none"
    rm /config/usb_gadget/g1/configs/b.1/f1
    rm /config/usb_gadget/g1/configs/b.1/f2
    write /config/usb_gadget/g1/idVendor 0x18D1
    write /config/usb_gadget/g1/idProduct 0x4EE2
    write /config/usb_gadget/g1/configs/b.1/strings/0x409/configuration "mtp_adb"
    symlink /config/usb_gadget/g1/functions/mtp.gs0 /config/usb_gadget/g1/configs/b.1/f1
    symlink /config/usb_gadget/g1/functions/ffs.adb /config/usb_gadget/g1/configs/b.1/f2
    write /config/usb_gadget/g1/UDC ${sys.usb.controller}
    # sideload waits for sys.usb.state
    setprop sys.usb.state ${sys.usb.config}

# mtp,adb uses f2 too; the default "none" rule only removes f1
on property:sys.usb.config=none && property:sys.usb.configfs=1
    rm /config/usb_gadget/g1/configs/b.1/f2

# fastbootd: use the bootloader PID so the usual fastboot driver works on Windows
on property:sys.usb.config=fastboot && property:sys.usb.ffs.ready=1 && property:sys.usb.configfs=1
    write /config/usb_gadget/g1/UDC "none"
    write /config/usb_gadget/g1/idProduct 0xD00D
    write /config/usb_gadget/g1/UDC ${sys.usb.controller}

on property:sys.usb.config=mtp && property:sys.usb.configfs=1
    write /config/usb_gadget/g1/UDC "none"
    rm /config/usb_gadget/g1/configs/b.1/f1
    rm /config/usb_gadget/g1/configs/b.1/f2
    write /config/usb_gadget/g1/idVendor 0x18D1
    write /config/usb_gadget/g1/idProduct 0x4EE1
    write /config/usb_gadget/g1/configs/b.1/strings/0x409/configuration "mtp"
    symlink /config/usb_gadget/g1/functions/mtp.gs0 /config/usb_gadget/g1/configs/b.1/f1
    write /config/usb_gadget/g1/UDC ${sys.usb.controller}
    setprop sys.usb.state ${sys.usb.config}

# The stock boot control HAL is @1.1
on property:hwservicemanager.ready=true
    start boot-hal-1-1

on init
    setprop prepdecrypt.loglevel 2
    # Take OS version / patch level from the installed system
    setprop prepdecrypt.setpatch true
    setprop keymaster_ver 4.1
